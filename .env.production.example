# -----------------------------------------------------------------------
# Modelo de ambiente de PRODUÇÃO. NÃO commitar o arquivo real .env.production
# (ele está no .gitignore).
#
# Na VPS (recomendado):
#   bash deploy/gerar-env-production.sh    # cria .env.production + APP_KEY
#   nano .env.production                   # APP_URL e senhas DB
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build
#
# BANCO: volume Docker "parque_aquatico_prod_db". Restart/rebuild NÃO apaga dados.
#        Nunca use: docker compose ... down -v
#        Não altere DB_PASSWORD/DB_ROOT_PASSWORD depois da 1ª subida do volume.
# -----------------------------------------------------------------------

APP_NAME="Parque Aquatico SaaS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# APP_URL SEMPRE https com o domínio público (Cloudflare).
APP_URL=https://softplanerp.com.br

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Credenciais do serviço "db" no docker-compose.prod.yml (rede interna).
# DB_ROOT_PASSWORD é lido pelo Compose para criar o container MySQL.
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=parque_aquatico
DB_USERNAME=parque_user
DB_PASSWORD=TROQUE_SENHA_FORTE_AQUI
DB_ROOT_PASSWORD=TROQUE_SENHA_ROOT_FORTE_AQUI
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Proxies: deixe o padrão (Docker + Cloudflare) ou use TRUSTED_PROXIES=*
# se a porta do app NÃO for pública (só proxy/túnel).
# TRUSTED_PROXIES=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="contato@SEU_DOMINIO.com.br"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_API_INSTANCE=parque-aquatico
EVOLUTION_API_TIMEOUT=15
EVOLUTION_API_RETRIES=3

MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_TIMEOUT=15
MERCADOPAGO_RETRIES=3

# --- Bluesoft Cosmos (fallback se empresa sem token) ---
COSMOS_TOKEN=
COSMOS_BASE_URL=https://api.cosmos.bluesoft.com.br
COSMOS_TIMEOUT=15
TOKEN_NFSE=
TOKEN_IBPT=

# NFS-e municipal GISS — pasta dos XSD (padrão: storage/SchemasXSDgiss)
# NFSE_GISS_SCHEMAS_PATH=
# NFSE_GISS_VALIDAR_SCHEMA=true

COBRANCA_DIAS_ANTES_VENCIMENTO=3
COBRANCA_DIAS_APOS_VENCIMENTO=1,5,10
CARTEIRINHA_QR_TTL_HORAS=24
