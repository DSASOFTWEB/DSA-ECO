# OpenSSL 3 desabilita algoritmos antigos por padrão. Alguns certificados A1
# ICP-Brasil ainda usam RC2/3DES no PKCS#12, por isso carregamos os providers
# default e legacy desde o início do processo PHP/Apache.
openssl_conf = openssl_init

[openssl_init]
providers = provider_sect

[provider_sect]
default = default_sect
legacy = legacy_sect

[default_sect]
activate = 1

[legacy_sect]
activate = 1
