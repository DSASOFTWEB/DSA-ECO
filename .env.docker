# -----------------------------------------------------------------------
# Env file consumido pelo docker-compose.yml (app, queue, scheduler) via
# `env_file: .env.docker`. Diferente do .env.example (que é para quem vai
# rodar composer/php artisan diretamente na própria máquina), este arquivo
# já vem PRONTO para `docker compose up -d`: DB_HOST aponta para o serviço
# "db" da própria stack, e o APP_KEY abaixo já é uma chave real e válida.
#
# ⚠️ Essa chave está commitada de propósito para o "sobe tudo com um
# comando" funcionar de primeira, sem passo manual de key:generate. Isso é
# aceitável para desenvolvimento/homologação local. Para qualquer ambiente
# exposto na internet, gere a sua própria com:
#   docker compose run --rm app php artisan key:generate --show
# e troque o valor abaixo antes de subir em produção.
# -----------------------------------------------------------------------

APP_NAME="Parque Aquatico SaaS"
APP_ENV=local
APP_KEY=base64:s0wYQVZ4jukzGxZ+yLQ/PKsN8e9vxLZSAEsrANJuEug=
APP_DEBUG=true
APP_URL=http://localhost:9091

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# "db" é o nome do serviço MySQL no docker-compose.yml — dentro da rede
# interna do Compose, os containers se enxergam pelo nome do serviço, não
# por localhost/127.0.0.1. Essas credenciais têm que bater com o bloco
# "environment" do serviço "db" em docker-compose.yml.
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=parque_aquatico
DB_USERNAME=parque_user
DB_PASSWORD=parque_pass
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# false aqui só porque o dev local roda em HTTP puro (localhost:9091, sem TLS).
# Em qualquer ambiente real por HTTPS, isto TEM que virar true, senão o
# cookie de sessão trafega sem a flag Secure.
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="contato@parqueaquatico.com.br"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# --- Integração WhatsApp (Evolution API) ---
# Se você já roda a Evolution API em outro container Docker na mesma
# máquina, aponte para o nome do serviço/container dela em vez de localhost.
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=
EVOLUTION_API_INSTANCE=parque-aquatico
EVOLUTION_API_TIMEOUT=15
EVOLUTION_API_RETRIES=3

# --- Integração Mercado Pago ---
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_TIMEOUT=15
MERCADOPAGO_RETRIES=3

# --- Regras de negócio ---
COBRANCA_DIAS_ANTES_VENCIMENTO=3
COBRANCA_DIAS_APOS_VENCIMENTO=1,5,10
CARTEIRINHA_QR_TTL_HORAS=24
